# URL base de la API18 (atención al cliente por WhatsApp), usada por la página
# de Conversaciones (/admin/conversaciones). Debe incluir el prefijo /api18.
# Por defecto (si no defines esta variable) el código usa la URL de producción:
# https://desarrollotecnologicoar.com/api18 (el servidor redirige http -> https,
# así que debe usarse https explícitamente para evitar bloqueos de CORS en el navegador).
# Para desarrollo local contra la API corriendo en tu máquina, descomenta:
# VITE_API18_URL=http://localhost:3018/api18

# URL CSV publicada de Google Sheets para cargar preguntas automáticamente.
# Ejemplo:
# VITE_GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/<ID>/gviz/tq?tqx=out:csv&sheet=Checklist
#
# Si el valor es "replace", las preguntas del Sheet reemplazan el catálogo local.
# Si no se define o se usa otro valor, se agregan al catálogo local.
# VITE_GOOGLE_SHEETS_MODE=append

# Firebase (login de administradores)
